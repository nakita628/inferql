{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "customConditions": ["source"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "migrations"],
  "contentMappers": [
    {
      "package": "inferql",
      "extensions": [".sql"],
      "options": { "dialect": "sqlite", "migrationsDir": "migrations" }
    }
  ]
}
