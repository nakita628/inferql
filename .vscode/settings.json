{
  // Oxc runs the `oxlint` from node_modules through Node, which is what lets inferql's JS
  // plugin (and its database-backed check) run inside the editor. Its language server reads only
  // the config at the workspace root, so the root `oxlint.config.ts` scopes each example's own
  // `oxlint.config.ts` to that example: the editor and `vp check` apply the same rules.
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  // Without this the extension prefers `vp lint --lsp` whenever vite-plus is installed, and that
  // server reads only the `lint` block of the root vite.config.ts, which this repository leaves
  // empty: no `sql('...')` would ever be flagged. Point it at oxlint itself, which reads the root
  // oxlint.config.ts.
  "oxc.path.oxlint": "node_modules/oxlint/bin/oxlint",
  // inferql's content mapper (`.sql` migrations → Schema, no schema file) needs TypeScript 7.1.
  // `useTsgo` only turns VS Code's bundled TypeScript off: the TypeScript 7 extension
  // (TypeScriptTeam.native-preview, recommended in extensions.json) runs the native server, from
  // example/sqlite's 7.1 install — its own copy is 7.0, without content mappers. Trust the
  // workspace and click Allow when it asks to use the workspace's TypeScript.
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "example/sqlite/node_modules/typescript",
  "oxc.lint.run": "onType",
  "oxc.typeAware": true
}
